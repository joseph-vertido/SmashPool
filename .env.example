# Firebase Web App configuration
# Firebase Console > Project settings > General > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=smashpool-d6818

# Optional but recommended for scalable profile-photo storage.
# Cloud Storage for Firebase currently requires the Blaze plan.
VITE_FIREBASE_STORAGE_BUCKET=

VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Use a different ID if you later want more than one betting pool.
VITE_SMASHPOOL_POOL_ID=main
