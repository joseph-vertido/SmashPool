rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Admin allow-list. Create these documents manually in the Firebase console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Full tournament state, including the complete bet ledger.
    match /adminPools/{poolId} {
      allow read, write: if isAdmin();
    }


    // Private historical event archives. Only approved admins can read or create them.
    match /eventArchives/{archiveId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Sanitized dashboard projection. This is the only tournament data public users can read.
    match /publicPools/{poolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
